{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Сборка проекта (g++)",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-Wall",
                "-I${workspaceFolder}/Attributes",
                "-I${workspaceFolder}/Categories",
                "-I${workspaceFolder}/Product",
                "-I${workspaceFolder}/Products",
                "-I${workspaceFolder}/Warehouse",
                "-I${workspaceFolder}/ProductFactories",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/Attributes/Attributes.cpp",
                "${workspaceFolder}/Categories/Categories.cpp",
                "${workspaceFolder}/Product/Product.cpp",
                "${workspaceFolder}/Products/Products.cpp",
                "${workspaceFolder}/Warehouse/Warehouse.cpp",
                "${workspaceFolder}/ProductFactories/ProductFactories.cpp",
                "-o",
                "${workspaceFolder}/warehouse.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Сборка всех .cpp проекта в warehouse.exe"
        }
    ]
}